<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyKanban.HomePage"
             BackgroundColor="#F5F5F5">
    <ContentPage.Resources>
        <Style x:Key="DayHeaderStyle" TargetType="Label">
            <!-- Setter = imposta una proprietà dello stile -->
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#888888"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </ContentPage.Resources>
    <!-- ScrollView = permette di scorrere tutta la pagina -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            <Label Text="Home" FontSize="28" FontAttributes="Bold"
                   TextColor="#1A1A1A" HorizontalTextAlignment="Center"/>

            <!-- CALENDARIO -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="#DDDDDD" StrokeThickness="1" Padding="16"
                    HorizontalOptions="Center" WidthRequest="320">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="‹"  FontSize="18"
                                TextColor="#333333" BackgroundColor="Transparent"
                                WidthRequest="32" HeightRequest="32" Padding="0"
                                Clicked="BtnPrev_Clicked"/>
                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                            <!-- Picker = menu a tendina -->
                            <Picker x:Name="MonthPicker" TextColor="#1A1A1A" FontSize="13"
                                    SelectedIndexChanged="Picker_Changed"/>
                            <Picker x:Name="YearPicker" TextColor="#1A1A1A" FontSize="13"
                                    SelectedIndexChanged="Picker_Changed"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="2" Text="›" FontSize="18"
                                TextColor="#333333" BackgroundColor="Transparent"
                                WidthRequest="32" HeightRequest="32" Padding="0"
                                Clicked="BtnNext_Clicked"/>
                    </Grid>
                    <!-- BoxView = piccolo rettangolo/pallino colorato -->
                    <BoxView HeightRequest="1" BackgroundColor="#EEEEEE"/>
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <Label Grid.Column="0" Text="Su" Style="{StaticResource DayHeaderStyle}"/>
                        <Label Grid.Column="1" Text="Mo" Style="{StaticResource DayHeaderStyle}"/>
                        <Label Grid.Column="2" Text="Tu" Style="{StaticResource DayHeaderStyle}"/>
                        <Label Grid.Column="3" Text="We" Style="{StaticResource DayHeaderStyle}"/>
                        <Label Grid.Column="4" Text="Th" Style="{StaticResource DayHeaderStyle}"/>
                        <Label Grid.Column="5" Text="Fr" Style="{StaticResource DayHeaderStyle}"/>
                        <Label Grid.Column="6" Text="Sa" Style="{StaticResource DayHeaderStyle}"/>
                    </Grid>
                    <Grid x:Name="DaysGrid"
                          ColumnDefinitions="*,*,*,*,*,*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="2" ColumnSpacing="2"/>
                </VerticalStackLayout>
            </Border>

            <!-- TITOLO DATA SELEZIONATA -->
            <Label x:Name="LblDataSelezionata"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="#1A1A1A" HorizontalTextAlignment="Center"/>

            <!-- 3 COLONNE TASK - STILE KANBAN -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">

                <!-- DA FARE -->
                <StackLayout BackgroundColor="#EEF2FF" Padding="10"
                             WidthRequest="320" Spacing="0">
                    <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="Center" Margin="0,10">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#6366F1"
                                 VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Label Text="Da fare" FontSize="20" FontAttributes="Bold"
                               TextColor="#4338CA"/>
                    </StackLayout>
                    <CollectionView x:Name="CvDaFare" SelectionMode="None" Margin="0,10">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" CornerRadius="13"
                                       Margin="5,5,5,5" BorderColor="#12000000" Padding="14">
                                    <StackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontSize="15"
                                               FontAttributes="Bold" TextColor="Black"/>
                                        <Frame BackgroundColor="#FEE2E2" CornerRadius="6"
                                               Padding="8,2" BorderColor="Transparent"
                                               HorizontalOptions="Start">
                                            <Label Text="{Binding priorityTask}" FontSize="11"
                                                   FontAttributes="Bold" TextColor="#B91C1C"/>
                                        </Frame>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="LblVuotoDaFare" Text="Nessuna attività"
                           FontSize="12" TextColor="#6366F1"
                           HorizontalTextAlignment="Center" Margin="0,4,0,10"/>
                </StackLayout>

                <!-- IN CORSO -->
                <StackLayout BackgroundColor="#FFF7ED" Padding="10"
                             WidthRequest="320" Spacing="0">
                    <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="Center" Margin="0,10">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#F97316"
                                 VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Label Text="In corso" FontSize="20" FontAttributes="Bold"
                               TextColor="#C2410C"/>
                    </StackLayout>
                    <CollectionView x:Name="CvInCorso" SelectionMode="None" Margin="0,10">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" CornerRadius="13"
                                       Margin="5,5,5,5" BorderColor="#12000000" Padding="14">
                                    <StackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontSize="15"
                                               FontAttributes="Bold" TextColor="Black"/>
                                        <Frame BackgroundColor="#FEF3C7" CornerRadius="6"
                                               Padding="8,2" BorderColor="Transparent"
                                               HorizontalOptions="Start">
                                            <Label Text="{Binding priorityTask}" FontSize="11"
                                                   FontAttributes="Bold" TextColor="#92400E"/>
                                        </Frame>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="LblVuotoInCorso" Text="Nessuna attività"
                           FontSize="12" TextColor="#C2410C"
                           HorizontalTextAlignment="Center" Margin="0,4,0,10"/>
                </StackLayout>

                <!-- FATTO -->
                <StackLayout BackgroundColor="#ECFDF5" Padding="10"
                             WidthRequest="320" Spacing="0">
                    <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="Center" Margin="0,10">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#10B981"
                                 VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Label Text="Fatto" FontSize="20" FontAttributes="Bold"
                               TextColor="#059669"/>
                    </StackLayout>
                    <CollectionView x:Name="CvFatte" SelectionMode="None" Margin="0,10">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" CornerRadius="13"
                                       Margin="5,5,5,5" BorderColor="#12000000"
                                       Padding="14" Opacity="0.7">
                                    <StackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontSize="15"
                                               FontAttributes="Bold" TextColor="#888888"
                                               TextDecorations="Strikethrough"/>
                                        <Frame BackgroundColor="#D1FAE5" CornerRadius="6"
                                               Padding="8,2" BorderColor="Transparent"
                                               HorizontalOptions="Start">
                                            <Label Text="{Binding priorityTask}" FontSize="11"
                                                   FontAttributes="Bold" TextColor="#065F46"/>
                                        </Frame>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="LblVuotoFatte" Text="Nessuna attività"
                           FontSize="12" TextColor="#059669"
                           HorizontalTextAlignment="Center" Margin="0,4,0,10"/>
                </StackLayout>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>