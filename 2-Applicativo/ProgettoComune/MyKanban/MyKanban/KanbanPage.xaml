<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyKanban.KanbanPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ColumnBackground">#E8E8E8</Color>
            <Color x:Key="ColumnTitleColor">#1A1A1A</Color>
            <Color x:Key="AddLinkColor">#3A3A3A</Color>

            <Style x:Key="ColumnTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource ColumnTitleColor}"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,8,0,12"/>
            </Style>

            <Style x:Key="AddLinkStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="{StaticResource AddLinkColor}"/>
            </Style>

            <Style x:Key="ExpandLinkStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="{StaticResource AddLinkColor}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Unica riga: contenuto centrato verticalmente e orizzontalmente -->
    <ScrollView Orientation="Horizontal"
                HorizontalScrollBarVisibility="Default"
                VerticalScrollBarVisibility="Never"
                Padding="12,16">

        <HorizontalStackLayout Spacing="12"
                               VerticalOptions="Center"
                               HorizontalOptions="Center">

            <!-- ===== COLONNA: DA FARE ===== -->
            <Border BackgroundColor="{StaticResource ColumnBackground}"
                    StrokeThickness="0"
                    WidthRequest="260"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, *, Auto"
                      Padding="10,10,10,10"
                      HorizontalOptions="Center">

                    <Label Grid.Row="0"
                           Text="Da fare"
                           Style="{StaticResource ColumnTitleStyle}"/>

                    <CollectionView Grid.Row="1"
                x:Name="DaFareCollectionView"
                HeightRequest="380"
                ItemsSource="{Binding DaFareItems}"
                SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="12"
                    Margin="0,0,0,8">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="6">

                                        <!-- Titolo -->
                                        <Label Text="{Binding Title}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                                        <!-- Descrizione -->
                                        <Label Text="{Binding description}"
                           FontSize="14"
                           TextColor="#555"
                           LineBreakMode="WordWrap"/>

                                        <!-- Priorità -->
                                        <HorizontalStackLayout Spacing="6">

                                            <Label Text="Priorità:"
                               FontAttributes="Bold"
                               FontSize="13"/>

                                            <Label Text="{Binding priorityTask}"
                               FontSize="13"/>

                                        </HorizontalStackLayout>

                                        <!-- Data -->
                                        <HorizontalStackLayout Spacing="6">

                                            <Label Text="Scadenza:"
                               FontAttributes="Bold"
                               FontSize="13"/>

                                            <Label Text="{Binding deadline, StringFormat='{0:dd/MM/yyyy}'}"
                               FontSize="13"/>

                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <HorizontalStackLayout Grid.Row="2"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,2"
                                           Spacing="12">
                        <Button Background="Transparent" Clicked="OnCreateClicked"
                                Text="Crea attività" HorizontalOptions="Center" TextColor="Blue"/>
                    </HorizontalStackLayout>

                </Grid>
            </Border>

            <!-- ===== COLONNA: IN CORSO ===== -->
            <Border BackgroundColor="{StaticResource ColumnBackground}"
                    StrokeThickness="0"
                    WidthRequest="260"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, *, Auto"
                      Padding="10,10,10,10"
                      HorizontalOptions="Center">

                    <Label Grid.Row="0"
                           Text="In corso"
                           Style="{StaticResource ColumnTitleStyle}"/>

                    <CollectionView Grid.Row="1"
                                    x:Name="InCorsoCollectionView"
                                    HeightRequest="380"
                                    ItemsSource="{Binding InCorsoItems}"
                                    SelectionMode="None"
                                    HorizontalOptions="Center">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="Red"
                                        StrokeThickness="0"
                                        HeightRequest="60"
                                        WidthRequest="236"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <HorizontalStackLayout Grid.Row="2"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,2"
                                           Spacing="12">
                        <Button Background="Transparent" Clicked="OnCreateClicked"
                                Text="Crea attività" HorizontalOptions="Center" TextColor="Blue"/>
                    </HorizontalStackLayout>

                </Grid>
            </Border>

            <!-- ===== COLONNA: FINITO ===== -->
            <Border BackgroundColor="{StaticResource ColumnBackground}"
                    StrokeThickness="0"
                    WidthRequest="260"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, *, Auto"
                      Padding="10,10,10,10"
                      HorizontalOptions="Center">

                    <Label Grid.Row="0"
                           Text="Finito"
                           Style="{StaticResource ColumnTitleStyle}"/>

                    <CollectionView Grid.Row="1"
                                    x:Name="FinitoCollectionView"
                                    HeightRequest="380"
                                    ItemsSource="{Binding FinitoItems}"
                                    SelectionMode="None"
                                    HorizontalOptions="Center">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        HeightRequest="60"
                                        WidthRequest="236"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <HorizontalStackLayout Grid.Row="2"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,2"
                                           Spacing="12">
                        <Button Background="Transparent" Clicked="OnCreateClicked"
                                Text="Crea attività" HorizontalOptions="Center" TextColor="Blue"/>
                    </HorizontalStackLayout>

                </Grid>
            </Border>
        </HorizontalStackLayout>
    </ScrollView>

</ContentPage>